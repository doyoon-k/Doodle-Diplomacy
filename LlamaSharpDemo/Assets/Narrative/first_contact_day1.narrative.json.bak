      "status": "final",
      "runtimeCue": "PizzaCitizenFarewell",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "The president asks the patrons to keep his visit quiet.",
      "repeat": "once-per-session",
      "speakerId": "citizen",
