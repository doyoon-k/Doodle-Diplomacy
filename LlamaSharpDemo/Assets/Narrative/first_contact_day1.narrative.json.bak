      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.pattern_meaning_requested",
      "sourceText": "A new response pattern is stable, but its meaning is unknown. Compare the samples and enter the meaning you want the translator to use.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "A stable off-category pattern needs a player-authored meaning before the translator can use it.",
      "tags": [
        "reactive",
        "pattern",
        "meaning"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "새로운 반응 패턴이 관찰 되었습니다. 제출하셨던 라벨들을 보고 카테고리에 이름을 붙여주십시오.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_probe_blank",
      "sectionId": "reactive_guidance",
      "order": 50,
      "enabled": true,
      "type": "reactive",
      "status": "final",
