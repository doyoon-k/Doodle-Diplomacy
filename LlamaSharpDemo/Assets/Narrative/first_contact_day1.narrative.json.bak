          "text": "여기는 피자집 아닌가? 한가하구만.",
          "status": "final"
        }
      ]
    },
    {
      "id": "car_pizza_sign_director",
      "sectionId": "car_arrival",
      "order": 40,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "CarPizzaSignDirector",
      "triggerEvent": "intro.car.pizza_sign",
      "condition": "The president finishes commenting on the restaurant.",
      "repeat": "once-per-session",
      "speakerId": "director",
      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.car.pizza_sign.director",
      "sourceText": "Let me explain once we are inside.",
      "advance": "automatic",
      "minimumSeconds": 2.8,
      "situation": "The director redirects the conversation toward the concealed entrance.",
      "beforeAction": "The president looks at the sign.",
      "afterAction": "The player regains control and can use the car door handle.",
      "stageDirection": "After this line, blend back to the president's car view and enable the exit interaction.",
      "tags": [
        "intro",
        "car",
        "pizza-sign",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "일단 들어가서 설명해 드리겠습니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_citizen_question",
      "sectionId": "pizza_restaurant",
      "order": 5,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PizzaCitizenQuestion",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "The president enters the dining area and the patrons recognize him.",
      "repeat": "once-per-session",
      "speakerId": "citizen",
      "speakerLocalizationKey": "",
      "speakerFallback": "CITIZEN",
      "localizationKey": "first_contact.intro.pizza.citizen_question",
      "sourceText": "Mr. President? What brings you here...?",
      "advance": "automatic",
      "minimumSeconds": 2.8,
      "situation": "A nearby patron stares at the unexpected visitor.",
      "beforeAction": "The director stops in the middle of the dining room.",
      "afterAction": "The director answers before the president can respond.",
      "stageDirection": "Keep the player in first person and allow free camera look.",
      "tags": [
        "intro",
        "pizza",
        "citizens",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "대통령님이 여긴 어쩐 일로...?",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_director_alien_joke",
      "sectionId": "pizza_restaurant",
      "order": 10,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PizzaDirectorAlienJoke",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "A patron asks why the president is at the restaurant.",
      "repeat": "once-per-session",
      "speakerId": "director",
      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.pizza.director_alien_joke",
      "sourceText": "What else? We are obviously here to meet aliens. Ha!",
      "advance": "automatic",
      "minimumSeconds": 3.4,
      "situation": "The director states the truth as if it were a joke.",
      "beforeAction": "The president hesitates.",
      "afterAction": "The patrons burst out laughing.",
      "stageDirection": "The director delivers the line casually.",
      "tags": [
        "intro",
        "pizza",
        "director",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "어쩐 일이긴요! 이 피자집 지하로 가면 외계인을 만날 수 있다고 해서 왔죠.",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_awkward_silence",
      "sectionId": "pizza_restaurant",
      "order": 15,
      "enabled": true,
      "type": "system",
      "status": "final",
      "runtimeCue": "PizzaAwkwardSilence",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "The director has just claimed that the party came to meet aliens.",
      "repeat": "once-per-session",
      "speakerId": "",
      "speakerLocalizationKey": "",
      "speakerFallback": "",
      "localizationKey": "first_contact.intro.pizza.awkward_silence.stage",
      "sourceText": "An awkward silence. The patrons stare at the director.",
      "advance": "automatic",
      "minimumSeconds": 2.2,
      "situation": "Nobody is sure whether the director is joking.",
      "beforeAction": "The director finishes his alien remark and the subtitle disappears.",
      "afterAction": "The patrons finally burst into laughter.",
      "stageDirection": "Do not display this beat as dialogue. Turn the patrons toward the director and hold on the uncomfortable silence.",
      "tags": [
        "intro",
        "pizza",
        "silence",
        "timing",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "어색한 침묵. 시민들이 국장을 이상하게 쳐다본다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_citizens_laugh",
      "sectionId": "pizza_restaurant",
      "order": 20,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PizzaCitizensLaugh",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "The director claims they are meeting aliens.",
      "repeat": "once-per-session",
      "speakerId": "citizens",
      "speakerLocalizationKey": "",
      "speakerFallback": "PATRONS",
      "localizationKey": "first_contact.intro.pizza.citizens_laugh",
      "sourceText": "Hahaha! That is a good one.",
      "advance": "automatic",
      "minimumSeconds": 2.5,
      "situation": "The room treats the truth as a harmless joke.",
      "beforeAction": "The patrons stare at the director for a beat.",
      "afterAction": "The president supplies a plausible excuse.",
      "stageDirection": "The four graybox patrons remain turned toward the player.",
      "tags": [
        "intro",
        "pizza",
        "citizens",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "으하하하하하하! 농담도 잘하시네.",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_president_cover",
      "sectionId": "pizza_restaurant",
      "order": 30,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PizzaPresidentCover",
      "triggerEvent": "intro.pizza.citizen_encounter",
      "condition": "The patrons laugh at the director's alien remark.",
      "repeat": "once-per-session",
      "speakerId": "president",
      "speakerLocalizationKey": "",
      "speakerFallback": "PRESIDENT",
      "localizationKey": "first_contact.intro.pizza.president_cover",
      "sourceText": "We were hungry and stopped for a bite. Please keep it between us.",
      "advance": "automatic",
      "minimumSeconds": 4.2,
      "situation": "The president improvises a mundane cover story.",
      "beforeAction": "The laughter begins to settle.",
      "afterAction": "The patron wishes the party well.",
      "stageDirection": "Do not lock the player's camera.",
      "tags": [
        "intro",
        "pizza",
        "president",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "흠...흠...배가 고파서 잠시 들렀습니다. 비밀로 해주세요.",
          "status": "final"
        }
      ]
    },
    {
      "id": "pizza_citizen_farewell",
      "sectionId": "pizza_restaurant",
      "order": 40,
      "enabled": true,
