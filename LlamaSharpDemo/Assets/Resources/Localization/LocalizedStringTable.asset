      text: "\uB808\uBAAC"
  - key: label.orange
    sourceText: orange
    translations:
    - locale: ko-KR
      text: "\uC624\uB80C\uC9C0"
  - key: label.pear
    sourceText: pear
    translations:
    - locale: ko-KR
      text: "\uBC30"
  - key: label.fruit
    sourceText: fruit
    translations:
    - locale: ko-KR
      text: "\uACFC\uC77C"
  - key: label.house
    sourceText: house
    translations:
    - locale: ko-KR
      text: "\uC9D1"
  - key: label.tree
    sourceText: tree
    translations:
    - locale: ko-KR
      text: "\uB098\uBB34"
  - key: label.flower
    sourceText: flower
    translations:
    - locale: ko-KR
      text: "\uAF43"
  - key: label.sun
    sourceText: sun
    translations:
    - locale: ko-KR
      text: "\uD0DC\uC591"
  - key: label.moon
    sourceText: moon
    translations:
    - locale: ko-KR
      text: "\uB2EC"
  - key: label.star
    sourceText: star
    translations:
    - locale: ko-KR
      text: "\uBCC4"
  - key: label.car
    sourceText: car
    translations:
    - locale: ko-KR
      text: "\uC790\uB3D9\uCC28"
  - key: label.bird
    sourceText: bird
    translations:
    - locale: ko-KR
      text: "\uC0C8"
  - key: label.cat
    sourceText: cat
    translations:
    - locale: ko-KR
      text: "\uACE0\uC591\uC774"
  - key: label.dog
    sourceText: dog
    translations:
    - locale: ko-KR
      text: "\uAC1C"
  - key: label.fish
    sourceText: fish
    translations:
    - locale: ko-KR
      text: "\uBB3C\uACE0\uAE30"
  - key: label.face
    sourceText: face
    translations:
    - locale: ko-KR
      text: "\uC5BC\uAD74"
  - key: label.eye
    sourceText: eye
    translations:
    - locale: ko-KR
      text: "\uB208"
  - key: label.hand
    sourceText: hand
    translations:
    - locale: ko-KR
      text: "\uC190"
  - key: label.heart
    sourceText: heart
    translations:
    - locale: ko-KR
      text: "\uD558\uD2B8"
  - key: label.sword
    sourceText: sword
    translations:
    - locale: ko-KR
      text: "\uAC80"
  - key: label.knife
    sourceText: knife
    translations:
    - locale: ko-KR
      text: "\uCE7C"
  - key: label.gun
    sourceText: gun
    translations:
    - locale: ko-KR
      text: "\uCD1D"
  - key: label.handgun
    sourceText: handgun
    translations:
    - locale: ko-KR
      text: "\uAD8C\uCD1D"
  - key: label.flag
    sourceText: flag
    translations:
    - locale: ko-KR
      text: "\uAE43\uBC1C"
  - key: label.abstract_mark
    sourceText: abstract mark
    translations:
