    {
      "id": "briefing_assignment_0079",
      "sectionId": "facility_briefing",
      "order": 10,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "BriefingWide",
      "triggerEvent": "intro.facility.briefing",
      "repeat": "once-per-session",
      "speakerId": "director",
      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.facility.briefing.assignment",
      "sourceText": "From now on, you will conduct humanity's first official diplomatic meeting with extraterrestrials.",
