      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.probe_blank",
      "sourceText": "The drawing is too empty to read. Draw one visible object.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "The vision check cannot find a drawing.",
