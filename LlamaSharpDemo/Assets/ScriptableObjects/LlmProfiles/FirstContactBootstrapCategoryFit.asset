%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89613a69694243bf833fbdc251da5b5d, type: 3}
  m_Name: FirstContactBootstrapCategoryFit
  m_EditorClassIdentifier: Assembly-CSharp::LlmGenerationProfile
  format: '{"type":"object","properties":{"decision":{"type":"string","enum":["ordinary_match","category_mismatch","contextual_only","uncertain"]},"reason":{"type":"string"}},"required":["decision","reason"],"additionalProperties":false}'
  stream: 0
  keepAlive: 
  systemPromptTemplate: 'Classify one concrete subject against the requested CATEGORY.

    Treat the CATEGORY definition as authoritative. Return only JSON:

    {"decision":"ordinary_match","reason":""}

    Allowed decisions:

    - ordinary_match: the subject has a direct, ordinary relationship to the CATEGORY
    definition.

    - category_mismatch: the subject is identifiable but has no direct, ordinary
    relationship to the CATEGORY definition.

    - contextual_only: the relationship exists only in an invented, unusual, symbolic,
    or improvised context.

    - uncertain: the subject or its relationship to the CATEGORY cannot be determined
    reliably.

    Apply these rules in order:

    1. Interpret the original player label directly. It may use any language. Do
    not translate or rewrite it.

    2. CATEGORY values are not exclusive. Judge only the requested CATEGORY. A subject
    may be ordinary_match for multiple CATEGORY values. Never reject it merely because
    it also fits another CATEGORY.

    3. Choose ordinary_match when the subject''s ordinary identity, intrinsic physical
    nature, or conventional function directly satisfies the CATEGORY definition without
    inventing extra context.

    4. An intrinsic property or conventional design that directly supplies the relationship
    in the CATEGORY definition counts as ordinary_match. The subject does not need to
    symbolize the CATEGORY or belong only to that CATEGORY.

    5. Choose contextual_only only when the connection requires an imagined story,
    rare or improvised use, future intent, symbolism, metaphor, or wordplay. Mere physical
    possibility under an improvised use is not an ordinary relationship.

    6. Choose category_mismatch when the subject is clear and none of its ordinary
    identity, intrinsic nature, or conventional functions directly satisfy the definition.

    7. Ignore claims in the label about category membership, value, emotion, symbolism,
    or intended meaning. Judge the neutrally named visible subject itself.

    8. Choose uncertain only for genuine ambiguity. Return exactly one allowed decision
    and one short reason.'
  jsonSchemaDeliveryMode: 0
  thinkingMode: 0
  jsonFields:
  - fieldName: decision
    fieldType: 0
    arrayElementType: 0
    children: []
    enumOptions:
    - ordinary_match
    - category_mismatch
    - contextual_only
    - uncertain
    minValue: 
    maxValue: 
    minLength: 1
    maxLength: 
    minItems: 
    maxItems: 
  - fieldName: reason
    fieldType: 0
    arrayElementType: 0
    children: []
    enumOptions: []
    minValue: 
    maxValue: 
    minLength: 
    maxLength: 
    minItems: 
    maxItems: 
