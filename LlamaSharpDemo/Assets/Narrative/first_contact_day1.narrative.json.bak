      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.facility.corridor.signal",
      "sourceText": "They probably communicate by emitting some kind of brainwave signal outside their bodies.",
