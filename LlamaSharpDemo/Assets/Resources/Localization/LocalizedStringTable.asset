  - key: first_contact.terminal.line.meaning
    sourceText: 'MEANING: {meaning}'
    translations:
    - locale: ko-KR
      text: "\uC758\uBBF8: {meaning}"
  - key: first_contact.terminal.line.calibration_complete
    sourceText: CALIBRATION COMPLETE
    translations:
