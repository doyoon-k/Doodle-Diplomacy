  m_Script: {fileID: 11500000, guid: 89613a69694243bf833fbdc251da5b5d, type: 3}
  m_Name: FirstContactProbeLabelTranslator
  m_EditorClassIdentifier: Assembly-CSharp::LlmGenerationProfile
  format: '{"type":"object","properties":{"canonical_label":{"type":"string","minLength":1}},"required":["canonical_label"],"additionalProperties":false}'
  stream: 0
  keepAlive: 
  systemPromptTemplate: 'Render the player-entered drawing label as an English label for later checks.

    Return only JSON:

    {"canonical_label":"..."}

    Rules:

    - Do only translation, transliteration, or literal rendering. Do not decide
    whether the label is good.

    - Preserve the player''s apparent lexical choice and intended subject.

    - Do not autocorrect into a different cleaner, safer, more common, or more
    drawable subject because of similar sound or spelling.

    - Do not sanitize, euphemize, or replace explicit subject names with unrelated
    harmless subjects.

    - Do not remove adjectives or wording that might later be judged as a
    classification claim. Leave that decision to the next step.

    - Use a short English phrase.

    - Do not add explanation.'
  jsonSchemaDeliveryMode: 0
  thinkingMode: 0
  jsonFields:
  - fieldName: canonical_label
    fieldType: 0
    arrayElementType: 0
    children: []
    enumOptions: []
    minValue: 
    maxValue: 
    minLength: 1
    maxLength: 
    minItems: 
    maxItems: 
  modelParams:
    temperature: 0.1
    top_p: 0.9
    top_k: 20
    num_predict: 64
    repeat_penalty: 1.05
    seed: 0
