%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74dc3bf9560f4914ad623fe79b14ee0d, type: 3}
  m_Name: first_contact_day1
  m_EditorClassIdentifier: Assembly-CSharp::DoodleDiplomacy.Narrative.NarrativeScenarioAsset
  schemaVersion: 1
  scenarioId: first_contact_day1
  title: "First Contact \u2014 Day 1"
  sourceLocale: en-US
  locales:
  - en-US
  - ko-KR
  sections:
  - id: intro_bridge
    title: Intro bridge
    order: 0
    summary: Temporary cards bridge the finished briefing script into the playable
      encounter.
  - id: news_broadcast
    title: In-car news broadcast
    order: 1
    summary: Readable in-game subtitles timed to the silent television footage in
      the presidential car.
  - id: car_arrival
    title: Car arrival
    order: 2
    summary: The president and director react to the broadcast, notice Zaucer Pizza,
      and prepare to leave the vehicle.
  - id: pizza_restaurant
    title: Pizza restaurant
    order: 3
    summary: Restaurant patrons recognize the president, the director jokes about
      aliens, and the party preserves its cover story.
  - id: elevator_descent
    title: Elevator descent
    order: 4
    summary: The president and director discuss the classified facility while descending
      from Zaucer Pizza.
  - id: facility_corridor
    title: Facility corridor
    order: 5
    summary: The director explains what the first contact revealed while escorting
      the president to the briefing room.
  - id: facility_briefing
    title: Translator briefing
    order: 6
    summary: Dr. Hwang explains the translator prototype, calibration task, and why
      the aliens will only respond to the president.
  - id: preflight
    title: Tablet preflight
    order: 7
    summary: Dr. Hwang checks the president's drawing and walks through the local
      probe controls before the delegation enters.
  - id: arrival
    title: Delegation arrival
    order: 10
    summary: The alien delegation enters and Dr. Hwang hands control to the player.
  - id: bootstrap
    title: Translator calibration
    order: 20
    summary: The player submits labeled drawings and builds stable response groups.
  - id: reactive_guidance
    title: Reactive guidance
    order: 30
    summary: Dr. Hwang explains validation results and how each submitted sample
      affects calibration.
  - id: alien_reactions
    title: Alien reactions
    order: 40
    summary: Short reaction captions selected by alien satisfaction.
  - id: translation_proof
    title: Automatic translation proof
    order: 50
    summary: A new signal is translated using the categories calibrated by the player.
  beats:
  - id: news_ufo_archive
    sectionId: news_broadcast
    order: 0
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: NewsUfoArchive
    triggerEvent: intro.news.clip.0
    condition: UFO VHS footage is playing on the in-car television
    repeat: once-per-session
    speakerId: ksea_news
    speakerLocalizationKey: 
    speakerFallback: KSEA 7 NEWS
    localizationKey: first_contact.intro.news.ufo_archive
    sourceText: This footage of an unidentified flying object was recorded over Redmond,
      Washington.
    advance: automatic
    minimumSeconds: 7.2
    situation: Silent VHS footage opens the broadcast.
    beforeAction: The camera is locked in front of the in-car television.
    afterAction: Cut to the field reporter.
    stageDirection: Show as a clean game subtitle below the noisy television image.
    tags:
    - intro
    - news
    - clip-0
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC6CC\uC2F1\uD134 \uC8FC \uB808\uB4DC\uBA3C\uB4DC \uC0C1\uACF5\uC5D0\uC11C
        \uBBF8\uD655\uC778 \uBB3C\uCCB4\uAC00 \uBE5B\uC744 \uBFDC\uC73C\uBA70 \uD65C\uACF5\uD558\uB294
        \uC7A5\uBA74\uC774 \uBC1C\uACAC\uB418\uC5B4 \uC2DC\uBBFC\uB4E4\uC774 \uBD88\uC548\uC5D0
        \uB5A8\uACE0 \uC788\uC2B5\uB2C8\uB2E4. "
      status: final
  - id: news_field_reporter
    sectionId: news_broadcast
    order: 10
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: NewsFieldReporter
    triggerEvent: intro.news.clip.1
    condition: The field reporter clip is playing
    repeat: once-per-session
    speakerId: field_reporter
    speakerLocalizationKey: 
    speakerFallback: FIELD REPORTER
    localizationKey: first_contact.intro.news.field_reporter
    sourceText: An unidentified flying object has been sighted over Redmond, east
      of Seattle, leaving residents confused.
    advance: automatic
    minimumSeconds: 8.4
    situation: A reporter introduces the Redmond sighting.
    beforeAction: The archive footage ends.
    afterAction: Cut to an eyewitness interview.
    stageDirection: Do not show an advance prompt.
    tags:
    - intro
    - news
    - clip-1
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC774\uACF3\uC740 \uCD5C\uCD08 \uBAA9\uACA9\uC790\uAC00 UFO\uB97C \uBD24\uB2E4\uACE0
        \uC81C\uBCF4\uD55C \uC232 \uADFC\uCC98\uC785\uB2C8\uB2E4. \uC0C1\uACF5\uC744
        \uB5A0\uB2E4\uB2C8\uB2E4\uAC00 \uC232\uC18D\uC73C\uB85C \uC465 \uB4E4\uC5B4\uAC14\uB2E4\uB294
        \uC99D\uC5B8\uB4E4\uC774 \uC774\uC5B4\uC9C0\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
      status: final
  - id: news_eyewitness
    sectionId: news_broadcast
    order: 20
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: NewsEyewitness
    triggerEvent: intro.news.clip.2
    condition: The eyewitness interview clip is playing
    repeat: once-per-session
    speakerId: eyewitness
    speakerLocalizationKey: 
    speakerFallback: EYEWITNESS
    localizationKey: first_contact.intro.news.eyewitness
    sourceText: I saw it with my own eyes! It appeared in an instant, flashed bright
      lights everywhere, then vanished into the forest!
    advance: automatic
    minimumSeconds: 5
    situation: A local eyewitness excitedly describes the object.
    beforeAction: The reporter narration ends.
    afterAction: Show the still photograph of the same object.
    stageDirection: The subtitle remains readable while the television graphics retain
      heavy VHS noise.
    tags:
    - intro
    - news
    - clip-2
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC81C \uB208\uC73C\uB85C \uBD84\uBA85\uC774 \uBD24\uC2B5\uB2C8\uB2E4.
        \uC21C\uC2DD\uAC04\uC5D0 \uB098\uD0C0\uB098 \uBE5B\uC744 \uB9C8\uAD6C \uBFDC\uB354\uB2C8
        \uC232\uC18D\uC73C\uB85C \uC0AC\uB77C\uC84C\uC9C0\uC694. "
      status: final
  - id: news_redmond_photo
    sectionId: news_broadcast
    order: 30
    enabled: 1
    type: caption
    status: final
    runtimeCue: NewsRedmondPhoto
    triggerEvent: intro.news.clip.3
    condition: The still photograph named ufo_oregon.jpg is shown as evidence from
      the same Redmond incident
    repeat: once-per-session
    speakerId: ksea_news
    speakerLocalizationKey: 
    speakerFallback: KSEA 7 NEWS
    localizationKey: first_contact.intro.news.redmond_photo
    sourceText: This is a still photograph of the same unidentified object seen over
      Redmond.
    advance: automatic
    minimumSeconds: 6
    situation: The broadcast holds on a photograph of the same UFO; the source filename
      is not story canon.
    beforeAction: The eyewitness interview ends.
    afterAction: Cut to the Air Force press conference.
    stageDirection: Do not describe this as a separate Oregon sighting.
    tags:
    - intro
    - news
    - clip-3
    - automatic
    - same-ufo
    localizedTexts:
    - locale: ko-KR
      text: "\uACF5\uAD70 \uCE21\uC5D0\uC11C \uCD2C\uC601\uB41C \uBBF8\uD655\uC778
        \uBB3C\uCCB4\uC758 \uAE30\uB85D \uC0AC\uC9C4\uC785\uB2C8\uB2E4. \uB9C8\uCE58
        \uBE44\uD589\uC811\uC2DC\uC758 \uBAA8\uC591\uC744 \uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
        \uACF5\uAD70 \uB2F9\uAD6D\uC740 \uC6B0\uC5F0\uD788 \uD3EC\uCC29\uB41C \uAE30\uC0C1\uD604\uC0C1\uC774\uB77C\uACE0
        \uD574\uBA85\uD588\uC2B5\uB2C8\uB2E4."
      status: final
  - id: news_air_force_explanation
    sectionId: news_broadcast
    order: 40
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: NewsAirForceExplanation
    triggerEvent: intro.news.clip.4
    condition: The Air Force press conference clip begins
    repeat: once-per-session
    speakerId: air_force_spokesperson
    speakerLocalizationKey: 
    speakerFallback: AIR FORCE SPOKESPERSON
    localizationKey: first_contact.intro.news.air_force_explanation
    sourceText: We believe last night's lights were caused by Venus, a weather balloon,
      and a nearby base's nighttime flare exercise appearing together by coincidence.
    advance: automatic
    minimumSeconds: 6
    situation: An Air Force spokesperson offers an implausible official explanation.
    beforeAction: The still photograph leaves the screen.
    afterAction: The spokesperson warns against spreading rumors.
    stageDirection: Keep the delivery dry and official.
    tags:
    - intro
    - news
    - clip-4
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC5B4\uC82F\uBC24 \uBAA9\uACA9\uB41C \uBD88\uBE5B\uC740 \uAE08\uC131,
        \uAE30\uC0C1\uAD00\uCE21\uC6A9 \uD48D\uC120, \uADF8\uB9AC\uACE0 \uC778\uADFC
        \uAE30\uC9C0\uC758 \uC57C\uAC04 \uC870\uBA85\uD0C4 \uD6C8\uB828\uC774 \uC6B0\uC5F0\uD788
        \uACB9\uCCD0 \uBCF4\uC778 \uAC83\uC73C\uB85C \uD310\uB2E8\uB429\uB2C8\uB2E4. "
      status: final
  - id: news_air_force_warning
    sectionId: news_broadcast
    order: 50
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: NewsAirForceWarning
    triggerEvent: intro.news.clip.4
    condition: The Air Force press conference continues
    repeat: once-per-session
    speakerId: air_force_spokesperson
    speakerLocalizationKey: 
    speakerFallback: AIR FORCE SPOKESPERSON
    localizationKey: first_contact.intro.news.air_force_warning
    sourceText: Be advised that spreading baseless rumors and causing public disorder
      may result in prosecution.
    advance: automatic
    minimumSeconds: 4
    situation: The spokesperson ends the explanation with a threat.
    beforeAction: The official explanation concludes.
    afterAction: The television powers off.
    stageDirection: Do not show an advance prompt.
    tags:
    - intro
    - news
    - clip-4
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uADFC\uAC70 \uC5C6\uB294 \uC18C\uBB38\uC73C\uB85C \uD63C\uB780\uC744
        \uD37C\uB728\uB9B4 \uACBD\uC6B0 \uCC98\uBC8C\uBC1B\uC744 \uC218 \uC788\uC73C\uB2C8
        \uC8FC\uC758\uD558\uC2DC\uAE30 \uBC14\uB78D\uB2C8\uB2E4."
      status: final
  - id: car_after_news_president
    sectionId: car_arrival
    order: 0
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: CarAfterNewsPresident
    triggerEvent: intro.car.after_news
    condition: The in-car television has powered off and the view returns to the
      president.
    repeat: once-per-session
    speakerId: president
    speakerLocalizationKey: 
    speakerFallback: PRESIDENT
    localizationKey: first_contact.intro.car.after_news.president
    sourceText: Will people really believe this? They are not idiots. There were
      too many witnesses.
    advance: automatic
    minimumSeconds: 4.4
    situation: The president reacts to the implausible official explanation.
    beforeAction: The television cuts to black.
    afterAction: The director defends the cover story.
    stageDirection: Keep the player seated in the car; movement and interaction remain
      locked.
    tags:
    - intro
    - car
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC774\uAC78 \uC0AC\uB78C\uB4E4\uC774 \uBBFF\uC744\uAE4C? \uC0AC\uB78C\uB4E4\uC774
        \uBC14\uBCF4\uB3C4 \uC544\uB2C8\uACE0. \uBCF8 \uC0AC\uB78C\uC774 \uD55C\uB458\uC774\uC5B4\uC57C\uC9C0."
      status: final
  - id: car_after_news_director_cover
    sectionId: car_arrival
    order: 10
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: CarAfterNewsDirectorCover
    triggerEvent: intro.car.after_news
    condition: The president questions the cover story.
    repeat: once-per-session
    speakerId: director
    speakerLocalizationKey: 
    speakerFallback: DIRECTOR
    localizationKey: first_contact.intro.car.after_news.director_cover
    sourceText: It was the best option available, Mr. President.
    advance: automatic
    minimumSeconds: 3
    situation: The director gives a restrained reply.
    beforeAction: The president finishes speaking.
    afterAction: The director announces the arrival.
    stageDirection: Do not give the player control yet.
    tags:
    - intro
    - car
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "UFO \uC598\uAE30\uB97C \uD558\uB294 \uC0AC\uB78C\uB4E4\uC744 \uACC4\uC18D\uD574\uC11C
        \uBBF8\uCE5C \uC0AC\uB78C\uCC98\uB7FC \uCDE8\uAE09\uD558\uB4EF \uC5EC\uB860\uC744
        \uB9CC\uB4E4\uBA74 \uB429\uB2C8\uB2E4 \uAC01\uD558."
      status: final
  - id: car_after_news_director_arrival
    sectionId: car_arrival
    order: 20
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: CarAfterNewsDirectorArrival
    triggerEvent: intro.car.after_news
    condition: The director looks out of the stopped vehicle.
    repeat: once-per-session
    speakerId: director
    speakerLocalizationKey: 
    speakerFallback: DIRECTOR
    localizationKey: first_contact.intro.car.after_news.director_arrival
    sourceText: We are almost there.
    advance: automatic
    minimumSeconds: 2.1
    situation: The car reaches the restaurant.
    beforeAction: The cover-story discussion ends.
    afterAction: The view moves to the restaurant sign.
    stageDirection: Hold on the normal car view before cutting to the sign shot.
    tags:
    - intro
    - car
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC774\uC81C \uAC70\uC758 \uB2E4 \uC654\uC2B5\uB2C8\uB2E4."
      status: final
  - id: car_pizza_sign_president
    sectionId: car_arrival
    order: 30
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: CarPizzaSignPresident
    triggerEvent: intro.car.pizza_sign
    condition: The camera holds on the Zaucer Pizza sign outside the vehicle.
    repeat: once-per-session
    speakerId: president
    speakerLocalizationKey: 
    speakerFallback: PRESIDENT
    localizationKey: first_contact.intro.car.pizza_sign.president
    sourceText: Isn't this a pizza place? It is pretty quiet.
    advance: automatic
    minimumSeconds: 3.2
    situation: The president notices the unlikely meeting location.
    beforeAction: The director announces that they have arrived.
    afterAction: The director asks the president to enter.
    stageDirection: The player view is locked to SHOT_Pizza_Sign.
    tags:
    - intro
    - car
    - pizza-sign
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC5EC\uAE30\uB294 \uD53C\uC790\uC9D1 \uC544\uB2CC\uAC00? \uD55C\uAC00\uD558\uAD6C\uB9CC."
      status: final
  - id: car_pizza_sign_director
    sectionId: car_arrival
    order: 40
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: CarPizzaSignDirector
    triggerEvent: intro.car.pizza_sign
    condition: The president finishes commenting on the restaurant.
    repeat: once-per-session
    speakerId: director
    speakerLocalizationKey: 
    speakerFallback: DIRECTOR
    localizationKey: first_contact.intro.car.pizza_sign.director
    sourceText: Let me explain once we are inside.
    advance: automatic
    minimumSeconds: 2.8
    situation: The director redirects the conversation toward the concealed entrance.
    beforeAction: The president looks at the sign.
    afterAction: The player regains control and can use the car door handle.
    stageDirection: After this line, blend back to the president's car view and enable
      the exit interaction.
    tags:
    - intro
    - car
    - pizza-sign
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC77C\uB2E8 \uB4E4\uC5B4\uAC00\uC11C \uC124\uBA85\uD574 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      status: final
  - id: pizza_citizen_question
    sectionId: pizza_restaurant
    order: 5
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: PizzaCitizenQuestion
    triggerEvent: intro.pizza.citizen_encounter
    condition: The president enters the dining area and the patrons recognize him.
    repeat: once-per-session
    speakerId: citizen
    speakerLocalizationKey: 
    speakerFallback: CITIZEN
    localizationKey: first_contact.intro.pizza.citizen_question
    sourceText: Mr. President? What brings you here...?
    advance: automatic
    minimumSeconds: 2.8
    situation: A nearby patron stares at the unexpected visitor.
    beforeAction: The director stops in the middle of the dining room.
    afterAction: The director answers before the president can respond.
    stageDirection: Keep the player in first person and allow free camera look.
    tags:
    - intro
    - pizza
    - citizens
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uB300\uD1B5\uB839\uB2D8\uC774 \uC5EC\uAE34 \uC5B4\uCA50 \uC77C\uB85C...?"
      status: final
  - id: pizza_director_alien_joke
    sectionId: pizza_restaurant
    order: 10
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: PizzaDirectorAlienJoke
    triggerEvent: intro.pizza.citizen_encounter
    condition: A patron asks why the president is at the restaurant.
    repeat: once-per-session
    speakerId: director
    speakerLocalizationKey: 
    speakerFallback: DIRECTOR
    localizationKey: first_contact.intro.pizza.director_alien_joke
    sourceText: What else? We are obviously here to meet aliens. Ha!
    advance: automatic
    minimumSeconds: 3.4
    situation: The director states the truth as if it were a joke.
    beforeAction: The president hesitates.
    afterAction: The patrons burst out laughing.
    stageDirection: The director delivers the line casually.
    tags:
    - intro
    - pizza
    - director
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC5B4\uCA50 \uC77C\uC774\uAE34\uC694! \uC774 \uD53C\uC790\uC9D1 \uC9C0\uD558\uB85C
        \uAC00\uBA74 \uC678\uACC4\uC778\uC744 \uB9CC\uB0A0 \uC218 \uC788\uB2E4\uACE0
        \uD574\uC11C \uC654\uC8E0."
      status: final
  - id: pizza_awkward_silence
    sectionId: pizza_restaurant
    order: 15
    enabled: 1
    type: system
    status: final
    runtimeCue: PizzaAwkwardSilence
    triggerEvent: intro.pizza.citizen_encounter
    condition: The director has just claimed that the party came to meet aliens.
    repeat: once-per-session
    speakerId: 
    speakerLocalizationKey: 
    speakerFallback: 
    localizationKey: first_contact.intro.pizza.awkward_silence.stage
    sourceText: An awkward silence. The patrons stare at the director.
    advance: automatic
    minimumSeconds: 2.2
    situation: Nobody is sure whether the director is joking.
    beforeAction: The director finishes his alien remark and the subtitle disappears.
    afterAction: The patrons finally burst into laughter.
    stageDirection: Do not display this beat as dialogue. Turn the patrons toward
      the director and hold on the uncomfortable silence.
    tags:
    - intro
    - pizza
    - silence
    - timing
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC5B4\uC0C9\uD55C \uCE68\uBB35. \uC2DC\uBBFC\uB4E4\uC774 \uAD6D\uC7A5\uC744
        \uC774\uC0C1\uD558\uAC8C \uCCD0\uB2E4\uBCF8\uB2E4."
      status: final
  - id: pizza_citizens_laugh
    sectionId: pizza_restaurant
    order: 20
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: PizzaCitizensLaugh
    triggerEvent: intro.pizza.citizen_encounter
    condition: The director claims they are meeting aliens.
    repeat: once-per-session
    speakerId: citizens
    speakerLocalizationKey: 
    speakerFallback: PATRONS
    localizationKey: first_contact.intro.pizza.citizens_laugh
    sourceText: Hahaha! That is a good one.
    advance: automatic
    minimumSeconds: 2.5
    situation: The room treats the truth as a harmless joke.
    beforeAction: The patrons stare at the director for a beat.
    afterAction: The president supplies a plausible excuse.
    stageDirection: The four graybox patrons remain turned toward the player.
    tags:
    - intro
    - pizza
    - citizens
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uC73C\uD558\uD558\uD558\uD558\uD558\uD558! \uB18D\uB2F4\uB3C4 \uC798\uD558\uC2DC\uB124."
      status: final
  - id: pizza_president_cover
    sectionId: pizza_restaurant
    order: 30
    enabled: 1
    type: dialogue
    status: final
    runtimeCue: PizzaPresidentCover
    triggerEvent: intro.pizza.citizen_encounter
    condition: The patrons laugh at the director's alien remark.
    repeat: once-per-session
    speakerId: president
    speakerLocalizationKey: 
    speakerFallback: PRESIDENT
    localizationKey: first_contact.intro.pizza.president_cover
    sourceText: We were hungry and stopped for a bite. Please keep it between us.
    advance: automatic
    minimumSeconds: 4.2
    situation: The president improvises a mundane cover story.
    beforeAction: The laughter begins to settle.
    afterAction: The patron wishes the party well.
    stageDirection: Do not lock the player's camera.
    tags:
    - intro
    - pizza
    - president
    - automatic
    localizedTexts:
    - locale: ko-KR
      text: "\uD760...\uD760...\uBC30\uAC00 \uACE0\uD30C\uC11C \uC7A0\uC2DC \uB4E4\uB800\uC2B5\uB2C8\uB2E4.
        \uBE44\uBC00\uB85C \uD574\uC8FC\uC138\uC694."
      status: final
  - id: pizza_citizen_farewell
    sectionId: pizza_restaurant
    order: 40
    enabled: 1
    type: dialogue
    status: final
