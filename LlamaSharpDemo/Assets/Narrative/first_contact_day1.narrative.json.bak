      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.bootstrap_calibrated",
      "sourceText": "All {count} categories are calibrated. Let us see whether it can translate a new signal.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "Every bootstrap category is stable and the translator can be tested.",
      "beforeAction": "The final category completes calibration.",
      "afterAction": "An unsolicited alien signal arrives.",
      "stageDirection": "Hold on the terminal before cutting to the aliens.",
      "tags": [
        "translation",
        "milestone"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "총 {count}개 분류의 보정이 끝났습니다. 이제 처음 듣는 신호도 번역하는지 확인해 보죠.",
          "status": "final"
        }
      ]
    },
    {
      "id": "translation_succeeded",
      "sectionId": "translation_proof",
      "order": 10,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "TranslationSucceeded",
      "triggerEvent": "terminal.translation.complete",
      "condition": "automatic demonstration result displayed",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.translation_succeeded",
      "sourceText": "It worked. Known categories are translating automatically; the unfamiliar part remains unresolved.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The terminal has translated known semantic segments in a brand-new signal.",
      "beforeAction": "The raw alien signal resolves category by category.",
      "afterAction": "Normal First Contact play continues with proven translation.",
      "stageDirection": "Let the translated terminal result remain visible.",
      "tags": [
        "translation",
        "payoff"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "됐습니다. 보정된 분류는 자동으로 번역됐고, 모르는 부분만 신호 그대로 남았습니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_bootstrap_duplicate_probe",
      "sectionId": "reactive_guidance",
      "order": 0,
      "enabled": true,
      "type": "reactive",
      "status": "final",
      "triggerEvent": "sample.rejected.duplicate",
      "condition": "the label repeats a sample already accepted for this category",
      "repeat": "first-occurrence",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.bootstrap_duplicate_probe",
      "sourceText": "The same sample repeats the same response. Try a different object in the same category.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "A duplicate cannot add a new point to the response group.",
      "tags": [
        "reactive",
        "sample",
        "duplicate"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "같은 그림은 같은 반응만 반복합니다. 같은 분류의 다른 사물 그림을 보내 주세요.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_bootstrap_category_mismatch",
      "sectionId": "reactive_guidance",
      "order": 10,
      "enabled": true,
      "type": "reactive",
      "status": "final",
      "triggerEvent": "sample.rejected.category_mismatch",
      "condition": "the object does not belong to the open category",
      "repeat": "first-occurrence",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.bootstrap_category_mismatch",
      "sourceText": "The drawing itself is usable, but it does not fit the current {category}, so it cannot be recorded as a response trace. Try another object from that category.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "The classifier rejects a clear category mismatch.",
      "tags": [
        "reactive",
        "sample",
        "category"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "그림에 반응해서 데이터도 수집되었습니다. 하지만 {category}에 해당하는 그림은 아닌 모양입니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_bootstrap_category_contextual",
      "sectionId": "reactive_guidance",
      "order": 20,
      "enabled": true,
      "type": "reactive",
      "status": "final",
      "triggerEvent": "sample.rejected.category_contextual",
      "condition": "the fit depends on symbolism, situation, or possible use",
      "repeat": "first-occurrence",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.bootstrap_category_contextual",
      "sourceText": "That connection depends on context, symbolism, or possible use. Send an object that belongs to the category by its ordinary identity.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "The proposed relation is indirect rather than inherent to the object.",
      "tags": [
        "reactive",
        "sample",
        "category"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "그 연관성은 맥락이나 상징, 가능한 용도에 의존합니다. 사물 자체가 현재 분류에 속하는 표본을 보내 주세요.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_bootstrap_category_uncertain",
      "sectionId": "reactive_guidance",
      "order": 30,
      "enabled": true,
      "type": "reactive",
      "status": "final",
      "triggerEvent": "sample.rejected.category_uncertain",
      "condition": "the classifier cannot establish category membership",
      "repeat": "first-occurrence",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.bootstrap_category_uncertain",
      "sourceText": "The device cannot establish this subject's ordinary relationship to the current category. Try a clearer example.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "The category evidence is ambiguous.",
      "tags": [
        "reactive",
        "sample",
        "category"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "이 사물과 현재 분류의 일반적인 관계를 판정할 수 없습니다. 더 분명한 표본을 보내 주세요.",
          "status": "final"
        }
      ]
    },
    {
