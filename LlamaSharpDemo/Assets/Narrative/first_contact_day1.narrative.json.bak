      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.preflight_passed",
      "sourceText": "Good enough. We have seen what we need; the practice sample will not be recorded.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The practice probe has cleared the local validation path without opening the alien response channel.",
      "beforeAction": "The preflight result appears on the terminal.",
      "afterAction": "The alien delegation enters and the real calibration round begins.",
      "stageDirection": "Hold on the preflight result, then cut to the delegation entrance.",
      "tags": [
        "onboarding",
        "preflight",
        "completion"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "좋습니다. 생각보다 꽤 잘 그리시는군요, 각하.",
          "status": "final"
        }
      ]
    },
    {
      "id": "delegation_arrival",
      "sectionId": "arrival",
      "order": 0,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "DelegationArrival",
      "triggerEvent": "encounter.opening.delegation_seated",
