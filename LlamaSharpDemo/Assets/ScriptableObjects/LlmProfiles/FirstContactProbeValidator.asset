    arrayElementType: 0
    children: []
    enumOptions: []
    minValue: 
    maxValue: 
    minLength: 
    maxLength: 
    minItems: 
    maxItems: 
  - fieldName: label_match
    fieldType: 0
    arrayElementType: 0
    children: []
    enumOptions:
    - match
    - unclear
    - mismatch
    minValue: 
