%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 89613a69694243bf833fbdc251da5b5d, type: 3}
  m_Name: FirstContactProbeLabelTranslator
  m_EditorClassIdentifier: Assembly-CSharp::LlmGenerationProfile
  format: '{"type":"object","properties":{"canonical_label":{"type":"string","minLength":1,"maxLength":64}},"required":["canonical_label"],"additionalProperties":false}'
  stream: 0
  keepAlive: 
  systemPromptTemplate: 'Translate the player-entered drawing label into one concise English helper label.

    Return only JSON:

    {"canonical_label":"..."}

    Rules:

    - The player is expected to name one concrete, visually depictable subject.
    The actual input language may differ from the UI locale or mix languages.

    - This step receives text only. Never infer content from a drawing.

    - The input is a drawing label, so prefer a common concrete noun or noun-phrase
    sense when the standalone wording genuinely permits one. Otherwise translate
    the wording literally without turning it into a subject.

    - For a short standalone word, do not omit a common noun, slang, taboo, or
    anatomical sense merely because a verb or polite dictionary sense is more frequent.

    - canonical_label must be English. Never echo the source-language text when an
    English translation exists.

    - Preserve literal vulgar, sexual, violent, or offensive meanings. Never sanitize
    them, euphemize them, or infer omitted words.

    - If direct translation is not possible, transliterate or render it literally.

    - Do not decide whether the label is good or suitable.

    - Do not remove adjectives or wording that might later be judged as a
    classification claim. Leave that decision to the next step.

    - Return one translation only. Do not add alternatives or explanation.'
  jsonSchemaDeliveryMode: 0
  thinkingMode: 0
  jsonFields:
  - fieldName: canonical_label
    fieldType: 0
    arrayElementType: 0
    children: []
    enumOptions: []
    minValue: 
    maxValue: 
    minLength: 1
    maxLength: 64
    minItems: 
    maxItems: 
  modelParams:
    temperature: 0
    top_p: 0.9
    top_k: 20
    num_predict: 64
    repeat_penalty: 1.05
    seed: 17331
  model: Models/gemma-3-4b-it-Q4_K_M.gguf
  visionProjectorModel: 
  visionProjectorRelativeToStreamingAssets: 1
  runtimeParams:
    modelPathRelativeToStreamingAssets: 1
    contextSize: 2048
    gpuLayerCount: 999
    threads: 12
