{
  "schemaVersion": 1,
  "catalogId": "game_ui",
  "title": "Doodle Diplomacy UI Copy",
  "sourceLocale": "en-US",
  "locales": [
    "en-US",
    "ko-KR"
  ],
  "screens": [
    {
      "id": "title.main",
      "title": "타이틀 화면",
      "surface": "menu",
      "description": "게임 시작과 설정 진입 메뉴"
    },
    {
      "id": "settings",
      "title": "설정",
      "surface": "menu",
      "description": "언어를 포함한 설정 화면"
    },
    {
      "id": "first_contact.intro",
      "title": "첫 접촉 인트로",
      "surface": "caption",
      "description": "임시 인트로 카드와 진행 안내"
    },
    {
      "id": "first_contact.terminal",
      "title": "첫 접촉 터미널",
      "surface": "terminal",
      "description": "PROBE / TRACE / GROUP 상태를 표시하는 장치 화면"
    },
    {
      "id": "first_contact.feedback",
      "title": "표본 판독 결과",
      "surface": "system",
      "description": "표본 검사와 오류 상태 문구"
    },
    {
      "id": "first_contact.semantic_map",
      "title": "의미 지도",
      "surface": "terminal",
      "description": "군집과 의미 지도 시각화"
    },
    {
      "id": "dialogue.shared",
      "title": "대화 공통",
      "surface": "dialogue",
      "description": "화자명과 대화 진행 안내"
    }
  ],
  "terms": [
    {
      "id": "probe",
      "sourceTerm": "Drawing Data",
      "targetTerm": "그림 데이터",
      "definition": "플레이어가 그려 외계 반응을 수집하는 그림 한 장.",
      "notes": "한국어 터미널에서는 ‘표본’, 설명 대사에서는 필요할 때 ‘시각 표본’. ‘탐침’은 사용하지 않음.",
      "status": "final"
    },
    {
      "id": "probe_label",
      "sourceTerm": "DRAWING LABEL",
      "targetTerm": "그림 라벨",
      "definition": "플레이어가 그림에 입력한 사물 이름.",
      "notes": "화면에 보이는 라벨은 현지화할 수 있음.",
      "status": "final"
    },
    {
      "id": "visual_probe",
      "sourceTerm": "VISUAL DATA",
      "targetTerm": "시각 데이터",
      "definition": "외계 반응을 얻기 위해 보내는 그림.",
      "notes": "설명 대사에서 bare ‘표본’이 모호할 때 사용.",
      "status": "final"
    },
    {
      "id": "trace",
      "sourceTerm": "REACTION",
      "targetTerm": "반응",
      "definition": "표본 하나에 대해 기록된 외계 반응 하나.",
      "notes": "터미널에서는 짧게 유지.",
      "status": "final"
    },
    {
      "id": "group",
      "sourceTerm": "GROUP",
      "targetTerm": "군집",
      "definition": "서로 비슷한 반응 추적의 묶음.",
      "notes": "안정 상태를 표시할 때 사용.",
      "status": "final"
    },
    {
      "id": "meaning",
      "sourceTerm": "MEANING",
      "targetTerm": "의미",
      "definition": "안정된 군집을 실제 외계 신호에 적용해 얻은 해석.",
      "notes": "이미 알려준 분류 목표를 되풀이하는 용도로 사용하지 않음.",
      "status": "final"
    },
    {
      "id": "category",
      "sourceTerm": "CATEGORY",
      "targetTerm": "분류",
      "definition": "현재 표본을 모으는 보정 목표 유형.",
      "notes": "내부 용어 SELECT-ONE을 플레이어에게 노출하지 않음.",
      "status": "final"
    },
    {
      "id": "signal",
      "sourceTerm": "SIGNAL",
      "targetTerm": "신호",
      "definition": "장치가 수신한 파형 또는 반응 신호.",
      "notes": "설명 대사에서는 ‘시각 표본 신호’ 사용 가능.",
      "status": "final"
    },
    {
      "id": "calibration",
      "sourceTerm": "CALIBRATION",
      "targetTerm": "보정",
      "definition": "알려진 분류와 안정된 군집의 연결 완료.",
      "notes": "분류 완료 화면은 ‘보정 완료’로 표시.",
      "status": "final"
    }
  ],
