    {
      "id": "elevator_descent_question_0070",
      "sectionId": "elevator_descent",
      "order": 30,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "ElevatorDescentQuestion",
      "triggerEvent": "intro.elevator.descent",
      "condition": "The hidden elevator has begun descending.",
      "repeat": "once-per-session",
      "speakerId": "president",
      "speakerLocalizationKey": "",
