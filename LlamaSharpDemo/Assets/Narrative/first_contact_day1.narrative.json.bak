    {
      "id": "preflight_intro",
      "sectionId": "preflight",
      "order": 0,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PreflightIntro",
      "triggerEvent": "preflight.started",
      "condition": "first play and preflight enabled",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.preflight_intro",
      "sourceText": "Before they arrive, I need to see whether you can produce a usable visual probe. ",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The delegation is still outside while Dr. Hwang begins a local equipment check.",
      "beforeAction": "The briefing ends and the tablet comes into view.",
      "afterAction": "The drawing tools illuminate.",
      "stageDirection": "Keep the tablet and its physical controls in frame.",
      "tags": [
        "onboarding",
        "preflight",
        "tablet"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "데이터 수집을 시작하기 전에 저랑 먼저 연습을 해보시죠 각하. ",
          "status": "final"
        }
      ]
    },
    {
      "id": "tablet_tools",
      "sectionId": "preflight",
      "order": 10,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "TabletTools",
      "triggerEvent": "preflight.controls.tools",
      "condition": "first play and preflight enabled",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.tablet_tools",
      "sourceText": "The three illuminated controls are the brush, fill, and eraser.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The brush, fill, and eraser controls pulse together.",
      "beforeAction": "The local preflight channel is shown on the terminal.",
      "afterAction": "The line-width and color controls illuminate.",
      "stageDirection": "Pulse only the three tool controls.",
      "tags": [
        "onboarding",
        "preflight",
        "controls"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "지금 점등된 세 버튼은 펜, 채우기, 지우개입니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "tablet_style",
      "sectionId": "preflight",
      "order": 20,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "TabletStyle",
      "triggerEvent": "preflight.controls.style",
      "condition": "first play and preflight enabled",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.tablet_style",
      "sourceText": "These buttons change line width. Use the slider beside them to choose a color.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The line-width buttons and color spectrum pulse together.",
      "beforeAction": "Dr. Hwang finishes identifying the tools.",
      "afterAction": "The history and clear controls illuminate.",
      "stageDirection": "Pulse the size buttons, spectrum, and color knob.",
      "tags": [
        "onboarding",
        "preflight",
        "controls"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "이 버튼들은 선 굵기를 바꾸고, 옆의 슬라이더로 색을 고를 수 있습니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "tablet_history_and_send",
      "sectionId": "preflight",
      "order": 30,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "TabletHistoryAndSend",
      "triggerEvent": "preflight.controls.history_and_send",
      "condition": "first play and preflight enabled",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.tablet_history_and_send",
      "sourceText": "Use these to undo, redo, or clear the canvas. When the drawing is ready, press Enter.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The undo, redo, and clear controls pulse together.",
      "beforeAction": "Dr. Hwang finishes identifying the style controls.",
      "afterAction": "All tutorial highlights turn off and the canvas unlocks.",
      "stageDirection": "Pulse the undo, redo, and clear controls.",
      "tags": [
        "onboarding",
        "preflight",
        "controls"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "이쪽은 순서대로 전체 삭제, 실행 취소, 다시 실행입니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "preflight_drawing",
      "sectionId": "preflight",
      "order": 40,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PreflightDrawing",
      "triggerEvent": "preflight.canvas.unlocked",
      "condition": "first play and preflight enabled",
      "repeat": "once-per-session",
      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.preflight_drawing",
      "sourceText": "Draw one concrete object. No words, symbols, scenes, or extra objects.",
      "advance": "player",
      "minimumSeconds": 0.3,
      "situation": "The drawing surface is unlocked for the practice probe.",
      "beforeAction": "The control walkthrough finishes.",
      "afterAction": "The player draws and submits a local practice probe.",
      "stageDirection": "Leave the tablet unobstructed after the subtitle closes.",
      "tags": [
        "onboarding",
        "preflight",
        "drawing"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "사물을 아무거나 딱 하나만 그려주십시오.\n글자나 기호, 복잡한 장면은 안 됩니다.\n색깔도 사용해서 그려 주시면 알아보기가 쉽습니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "preflight_passed",
      "sectionId": "preflight",
      "order": 50,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "PreflightPassed",
      "triggerEvent": "preflight.completed",
      "condition": "practice probe passed or local analysis was overridden",
