      "localizationKey": "first_contact.intro.elevator.descent.question",
      "sourceText": "Where does this lead?",
      "advance": "automatic",
      "minimumSeconds": 2.2,
      "situation": "The elevator leaves the restaurant level.",
      "beforeAction": "The player presses the elevator control and the concealed door closes.",
      "afterAction": "The director begins explaining the classified facility.",
      "stageDirection": "Keep the camera under player control inside the elevator.",
      "tags": [
        "intro",
        "elevator",
        "president",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "이건 어디로 이어지지?",
          "status": "final"
        }
      ]
    },
    {
      "id": "elevator_descent_first_contact_0071",
      "sectionId": "elevator_descent",
      "order": 40,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "ElevatorDescentFirstContact",
      "triggerEvent": "intro.elevator.descent",
      "condition": "The elevator is descending to the classified facility.",
      "repeat": "once-per-session",
      "speakerId": "director",
      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.elevator.descent.first_contact",
      "sourceText": "A few years ago, after our first unofficial contact with extraterrestrials, the government formed a dedicated organization to prepare for an official meeting like today's.",
      "advance": "automatic",
      "minimumSeconds": 7.2,
      "situation": "The director reveals that contact with extraterrestrials has already occurred.",
      "beforeAction": "The president asks where the elevator leads.",
      "afterAction": "The director explains the translator project.",
      "stageDirection": "The elevator hum continues beneath the dialogue.",
      "tags": [
        "intro",
        "elevator",
        "director",
        "exposition",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "몇 년 전 외계인과 처음 비공식적으로 조우한 이후, 정부는 전담 조직을 만들어 오늘 같은 공식 회담을 준비해왔습니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "elevator_descent_darpa_0072",
      "sectionId": "elevator_descent",
      "order": 50,
      "enabled": true,
      "type": "dialogue",
      "status": "final",
      "runtimeCue": "ElevatorDescentDarpa",
      "triggerEvent": "intro.elevator.descent",
      "condition": "The elevator continues descending.",
      "repeat": "once-per-session",
      "speakerId": "director",
      "speakerLocalizationKey": "",
      "speakerFallback": "DIRECTOR",
      "localizationKey": "first_contact.intro.elevator.descent.darpa",
      "sourceText": "Working with DARPA, we gathered our best researchers to develop a translator for their language.",
      "advance": "automatic",
      "minimumSeconds": 5.4,
      "situation": "The director introduces the translator research program.",
      "beforeAction": "The director describes the government's contact organization.",
      "afterAction": "The elevator arrives at the underground facility.",
      "stageDirection": "Complete the surface segment after this line.",
      "tags": [
        "intro",
        "elevator",
        "director",
        "darpa",
        "automatic"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "DARPA를 중심으로 저희가 가진 최고의 연구원들을 모아 그들의 언어를 번역하는 번역기를 만들고자 연구를 진행해왔지요.",
          "status": "final"
        }
      ]
    },
    {
      "id": "facility_corridor_discovery_0073",
      "sectionId": "facility_corridor",
      "order": 0,
