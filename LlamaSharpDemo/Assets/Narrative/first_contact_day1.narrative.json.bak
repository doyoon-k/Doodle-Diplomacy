      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.doctor_hwang.bootstrap_category_mismatch",
      "sourceText": "The aliens responded and the data was recorded, but the drawing does not appear to belong to {category}.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "Any category mismatch, contextual-only relation, or uncertain relation is recorded without advancing the active category trace.",
      "tags": [
        "reactive",
        "sample",
        "category"
      ],
      "localizedTexts": [
        {
          "locale": "ko-KR",
          "text": "그림에 반응해서 데이터도 수집되었습니다. 하지만 {category}에 해당하는 그림은 아닌 모양입니다.",
          "status": "final"
        }
      ]
    },
    {
      "id": "doctor_hwang_pattern_meaning_requested",
      "sectionId": "reactive_guidance",
      "order": 20,
      "enabled": true,
      "type": "reactive",
      "status": "final",
      "triggerEvent": "pattern.meaning.requested",
