      "localizationKey": "first_contact.doctor_hwang.pattern_meaning_requested",
      "sourceText": "A new response pattern is stable, but its meaning is unknown. Compare the samples and enter the meaning you want the translator to use.",
      "advance": "player",
      "minimumSeconds": 0,
      "situation": "A stable off-category pattern needs a player-authored meaning before the translator can use it.",
      "tags": [
