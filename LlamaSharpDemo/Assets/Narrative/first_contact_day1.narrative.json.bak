      "speakerId": "doctor_hwang",
      "speakerLocalizationKey": "speaker.doctor_hwang",
      "speakerFallback": "Dr. Hwang",
      "localizationKey": "first_contact.narrative.delegation_arrival",
      "sourceText": "The delegation is in position. The terminal will record their response.",
